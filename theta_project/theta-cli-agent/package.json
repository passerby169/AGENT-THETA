{
  "name": "theta-cli-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local THETA CLI Agent built on Hypha tool governance contracts.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "theta": "dist/cli.js",
    "theta-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rag:build": "node dist/rag/build-index.js",
    "cli": "node --disable-warning=ExperimentalWarning dist/cli.js",
    "theta": "node --disable-warning=ExperimentalWarning dist/cli.js",
    "web:api": "node --disable-warning=ExperimentalWarning dist/web-api/server.js",
    "hypha:check": "node ../scripts/check-hypha-version.mjs",
    "hypha:build": "npm --prefix ../Hypha run build:packages",
    "release:verify": "node scripts/run-release-gates.mjs",
    "release:clean-install": "node scripts/clean-install-smoke.mjs"
  },
  "dependencies": {
    "@hypha/adapters-local": "file:../Hypha/packages/adapters-local",
    "@hypha/core": "file:../Hypha/packages/core",
    "@hypha/domain": "file:../Hypha/packages/domain",
    "@hypha/fsm": "file:../Hypha/packages/fsm",
    "@hypha/harness": "file:../Hypha/packages/harness",
    "@hypha/inference": "file:../Hypha/packages/inference",
    "@hypha/kernel": "file:../Hypha/packages/kernel",
    "@hypha/mcp": "file:../Hypha/packages/mcp",
    "@hypha/memory": "file:../Hypha/packages/memory",
    "@hypha/skills": "file:../Hypha/packages/skills",
    "@hypha/storage": "file:../Hypha/packages/storage",
    "@hypha/tools": "file:../Hypha/packages/tools",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "busboy": "^1.6.0",
    "fast-json-stable-stringify": "^2.1.0",
    "ioredis": "5.10.1",
    "mongodb": "6.20.0",
    "yaml": "^2.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.13.3",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
