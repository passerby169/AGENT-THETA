{
  "name": "theta-cli-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local THETA CLI Agent built on Hypha tool governance contracts.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "theta": "dist/cli.js",
    "theta-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rag:build": "node dist/cli.js rag build --json",
    "cli": "node --disable-warning=ExperimentalWarning dist/cli.js",
    "theta": "node --disable-warning=ExperimentalWarning dist/cli.js",
    "web:api": "node --disable-warning=ExperimentalWarning dist/web-api/server.js",
    "demo": "node dist/cli.js demo",
    "hypha:check": "node ../scripts/check-hypha-version.mjs",
    "hypha:build": "npm --prefix ../Hypha run build:packages",
    "smoke:architecture-boundary": "node dist/architecture-boundary-smoke.js",
    "smoke:theta-domain": "node dist/theta-domain-smoke.js",
    "smoke:research-agent": "node dist/research-agent-smoke.js",
    "smoke:recommendation-golden": "node dist/recommendation-golden-smoke.js",
    "smoke:planning-chain": "node dist/planning-chain-smoke.js",
    "smoke:theta-workflow": "node dist/theta-workflow-smoke.js",
    "smoke:hypha-dataset-tools": "node dist/hypha-dataset-tools-smoke.js",
    "smoke:dataset-understanding-v2": "node dist/dataset-understanding-v2-smoke.js",
    "smoke:v2-intelligence": "node dist/v2-intelligence-smoke.js",
    "smoke:v2-research-store": "node dist/v2-research-store-smoke.js",
    "smoke:hypha-import": "node dist/hypha-import-smoke.js",
    "smoke:hypha-registry": "node dist/hypha-registry-smoke.js",
    "smoke:hypha-runner": "node dist/hypha-runner-smoke.js",
    "smoke:hypha-model-recommend": "node dist/hypha-model-recommend-smoke.js",
    "smoke:hypha-plan-validate": "node dist/hypha-plan-validate-smoke.js",
    "smoke:hypha-plan-create-approval": "node dist/hypha-plan-create-approval-smoke.js",
    "smoke:hypha-plan-create-approved": "node dist/hypha-plan-create-approved-smoke.js",
    "smoke:hypha-plan-lifecycle": "node dist/hypha-plan-lifecycle-smoke.js",
    "smoke:hypha-training-controls": "node dist/hypha-training-controls-smoke.js",
    "smoke:training-runtime": "node dist/training-runtime-smoke.js",
    "smoke:agent-cli": "node dist/agent-cli-smoke.js",
    "smoke:operator-commands": "node dist/operator-command-smoke.js",
    "smoke:conversation-ux": "node dist/conversation-ux-smoke.js",
    "smoke:ux-recovery": "node dist/ux-recovery-acceptance-smoke.js",
    "smoke:web-api": "node dist/web-api-smoke.js",
    "smoke:rag-governance": "node dist/rag-governance-smoke.js",
    "smoke:language-governance": "node dist/language-governance-smoke.js",
    "test:contracts": "node dist/contract-suite-smoke.js",
    "test:policy": "node dist/policy-suite-smoke.js",
    "test:replay": "node dist/theta-workflow-smoke.js",
    "test:rag-eval": "node dist/rag-evaluation-smoke.js",
    "test:python-runtime": "python -m unittest discover ../theta_agent_bridge/tests -p \"test_*.py\"",
    "smoke:cli": "node --disable-warning=ExperimentalWarning dist/cli-smoke.js",
    "release:verify": "node scripts/run-release-gates.mjs",
    "release:clean-install": "node scripts/clean-install-smoke.mjs"
  },
  "dependencies": {
    "@hypha/adapters-local": "file:../Hypha/packages/adapters-local",
    "@hypha/core": "file:../Hypha/packages/core",
    "@hypha/domain": "file:../Hypha/packages/domain",
    "@hypha/fsm": "file:../Hypha/packages/fsm",
    "@hypha/harness": "file:../Hypha/packages/harness",
    "@hypha/inference": "file:../Hypha/packages/inference",
    "@hypha/kernel": "file:../Hypha/packages/kernel",
    "@hypha/mcp": "file:../Hypha/packages/mcp",
    "@hypha/memory": "file:../Hypha/packages/memory",
    "@hypha/skills": "file:../Hypha/packages/skills",
    "@hypha/storage": "file:../Hypha/packages/storage",
    "@hypha/tools": "file:../Hypha/packages/tools",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "yaml": "^2.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
